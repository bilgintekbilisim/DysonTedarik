# Dyson Tedarik — production ortamı şablonu
# Sunucuda proje kök dizinine ".env" adıyla kopyalayın ve <...> alanlarını doldurun.
# Bu dosya git'e eklenir; gerçek .env asla eklenmez.

APP_NAME="Dyson Tedarik"
APP_ENV=production
# php artisan key:generate ile bir kez üretilir; sonra değiştirilmez.
APP_KEY=
APP_DEBUG=false
# Tek adres: tüm http ve www/www'suz istekler buraya 301 ile yönlendirilir.
APP_URL=https://www.dysontedarik.com
APP_TIMEZONE=Europe/Istanbul

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<cpanelkullanici_dysontedarik>
DB_USERNAME=<cpanelkullanici_dbuser>
DB_PASSWORD=<güçlü-şifre>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Cloudflare veya hosting proxy'si kullanılıyorsa "*" yapın; aksi halde boş bırakın.
TRUSTED_PROXIES=

# cPanel e-posta hesabı (ör. bildirim@dysontedarik.com). Port 465 için MAIL_SCHEME=smtps.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=<mail.dysontedarik.com>
MAIL_PORT=465
MAIL_USERNAME=<bildirim@dysontedarik.com>
MAIL_PASSWORD=<e-posta-şifresi>
MAIL_FROM_ADDRESS="<bildirim@dysontedarik.com>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# İlk yönetici hesabı — yalnızca ilk "php artisan db:seed" için. Kurulumdan sonra bu iki satırı silin.
ADMIN_NAME="Site Yöneticisi"
ADMIN_EMAIL=
ADMIN_PASSWORD=
